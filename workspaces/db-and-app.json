{
  "$schema": "../schemas/workspace.schema.json",
  "name": "App + database",
  "description": "One large pane for the app server with two smaller panes on the right. No broadcast group.",
  "autoConnect": false,
  "layout": {
    "type": "split",
    "orientation": "columns",
    "ratio": 0.6,
    "first": { "type": "pane", "id": "p1", "connectionId": "app-01" },
    "second": {
      "type": "split",
      "orientation": "rows",
      "ratio": 0.5,
      "first": { "type": "pane", "id": "p2", "connectionId": "db-01" },
      "second": { "type": "pane", "id": "p3", "connectionId": "db-02" }
    }
  }
}
