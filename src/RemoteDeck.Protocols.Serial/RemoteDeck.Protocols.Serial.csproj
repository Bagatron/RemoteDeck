<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RemoteDeck.Protocols.Serial</AssemblyName>
    <RootNamespace>RemoteDeck.Protocols.Serial</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft's serial port support (COM ports); MIT licensed. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depends only on the public plugin contracts, exactly like a community plugin would. -->
    <ProjectReference Include="..\RemoteDeck.Plugin.Abstractions\RemoteDeck.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteDeck.Protocols.Serial.Tests" />
  </ItemGroup>

</Project>
