<Window x:Class="RemoteDeck.App.Sftp.SftpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="620" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,6">
            <Button Content="Up" DockPanel.Dock="Left" Padding="12,4" Click="Up_Click" />
            <Button Content="Refresh" DockPanel.Dock="Left" Padding="12,4" Margin="6,0,0,0" Click="Refresh_Click" />
            <TextBox x:Name="PathBox" Margin="10,0,0,0" Padding="6,4" VerticalContentAlignment="Center" KeyDown="PathBox_KeyDown" />
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="10,0,10,8">
            <Button Content="Upload files..." Padding="10,4" Margin="0,0,6,0" Click="UploadFiles_Click" />
            <Button Content="Upload folder..." Padding="10,4" Margin="0,0,6,0" Click="UploadFolder_Click" />
            <Button Content="Download" Padding="10,4" Margin="0,0,6,0" Click="Download_Click" />
            <Button Content="New folder" Padding="10,4" Margin="0,0,6,0" Click="NewFolder_Click" />
            <Button Content="Rename" Padding="10,4" Margin="0,0,6,0" Click="Rename_Click" />
            <Button Content="Delete" Padding="10,4" Click="Delete_Click" />
        </WrapPanel>

        <Border DockPanel.Dock="Bottom" Padding="10,6" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Padding="10,2" Visibility="Collapsed" Click="Cancel_Click" />
                <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="120" Height="8" Margin="0,0,10,0"
                             IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <ListView x:Name="Files" Margin="10,0,10,10" SelectionMode="Extended" AllowDrop="True"
                  Drop="Files_Drop" DragOver="Files_DragOver" MouseDoubleClick="Files_DoubleClick"
                  Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}"
                  BorderBrush="{DynamicResource Line}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="400" DisplayMemberBinding="{Binding Display}" />
                    <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding ModifiedText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
