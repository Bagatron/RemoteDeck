<UserControl x:Class="RemoteDeck.App.Dialogs.WebPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>
                <Button x:Name="BackButton" DockPanel.Dock="Left" Content="Back" Padding="10,3" IsEnabled="False" Click="Back_Click" />
                <Button x:Name="ForwardButton" DockPanel.Dock="Left" Content="Forward" Padding="10,3" Margin="6,0,0,0" IsEnabled="False" Click="Forward_Click" />
                <Button DockPanel.Dock="Left" Content="Reload" Padding="10,3" Margin="6,0,0,0" Click="Reload_Click" />
                <Button DockPanel.Dock="Right" Content="Open in browser" Padding="10,3" Margin="8,0,0,0" Click="External_Click" />
                <TextBlock x:Name="AddressText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="Warning" DockPanel.Dock="Top" Visibility="Collapsed" Padding="10,4"
                   Background="{DynamicResource Panel}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
        <wv2:WebView2 x:Name="Browser" />
    </DockPanel>
</UserControl>
