<Window x:Class="RemoteDeck.App.Dialogs.UnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteDeck" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Back}" Foreground="{StaticResource Text}">
    <StackPanel Margin="22">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="Explanation" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />

        <TextBlock Text="Master password" Margin="0,16,0,4" Foreground="{StaticResource TextDim}" />
        <PasswordBox x:Name="PasswordBox" Padding="6,5" />

        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
            <TextBlock Text="Repeat it" Margin="0,12,0,4" Foreground="{StaticResource TextDim}" />
            <PasswordBox x:Name="ConfirmBox" Padding="6,5" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" IsDefault="True" Padding="18,5" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Quit" IsCancel="True" Padding="18,5" />
        </StackPanel>
    </StackPanel>
</Window>
