<Window x:Class="RemoteDeck.App.Dialogs.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="380" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}"
        BorderBrush="{DynamicResource Line}" BorderThickness="1"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="10">
        <TextBox x:Name="QueryBox" DockPanel.Dock="Top" Padding="8,6" FontSize="15" TextChanged="QueryBox_TextChanged" />
        <ListBox x:Name="Results" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch" MouseDoubleClick="Results_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,2">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Foreground="{DynamicResource TextDim}" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
