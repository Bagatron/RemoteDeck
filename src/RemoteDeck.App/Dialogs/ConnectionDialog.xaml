<Window x:Class="RemoteDeck.App.Dialogs.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Back}" Foreground="{StaticResource Text}">
    <StackPanel Margin="20">
        <TextBlock Text="Type" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
        <ComboBox x:Name="TypeBox" Padding="6,5" SelectionChanged="TypeBox_SelectionChanged">
            <ComboBoxItem Content="SSH" Tag="ssh" />
            <ComboBoxItem Content="Telnet (not encrypted)" Tag="telnet" />
            <ComboBoxItem Content="Remote Desktop (RDP)" Tag="rdp" />
            <ComboBoxItem Content="Web page (http / https)" Tag="web" />
        </ComboBox>

        <TextBlock Text="Name" Foreground="{StaticResource TextDim}" Margin="0,12,0,4" />
        <TextBox x:Name="NameBox" Padding="6,5" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HostLabel" Text="Host" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
                <TextBox x:Name="HostBox" Padding="6,5" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Port" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
                <TextBox x:Name="PortBox" Padding="6,5" ToolTip="Leave empty for 22" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="LoginPanel">
        <TextBlock Text="Username" Foreground="{StaticResource TextDim}" Margin="0,12,0,4" />
        <TextBox x:Name="UserBox" Padding="6,5" />

        <StackPanel x:Name="SecretPanel">
        <TextBlock x:Name="PasswordLabel" Text="Password" Foreground="{StaticResource TextDim}" Margin="0,12,0,4" />
        <PasswordBox x:Name="PasswordBox" Padding="6,5" />

        <TextBlock Text="Private key file (optional)" Foreground="{StaticResource TextDim}" Margin="0,12,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Padding="10,4" Click="Browse_Click" />
            <TextBox x:Name="KeyBox" Padding="6,5" />
        </DockPanel>
        <CheckBox x:Name="AgentBox" Content="Use keys from the SSH agent (Pageant or Windows OpenSSH)" Margin="0,8,0,0" />
        <TextBlock Text="With a key, the password is the key's passphrase."
                   Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextDim}" />
        </StackPanel>
        </StackPanel>

        <StackPanel x:Name="RdpPanel" Visibility="Collapsed">
            <CheckBox x:Name="ExternalBox" Content="Open in the Windows Remote Desktop app instead of a tab" Margin="0,12,0,0" />
            <TextBlock Text="By default the session opens in a RemoteDeck tab and asks for the password each time; it is never saved."
                       Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
        </StackPanel>

        <StackPanel x:Name="TelnetPanel" Visibility="Collapsed">
            <TextBlock Text="Telnet sends everything, including the login you type, without encryption. Use it only for devices on a network you trust. There is nothing to save here: you log in at the remote prompt."
                       Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
            <CheckBox x:Name="LocalEchoBox" Content="Show what I type myself (for devices that do not echo)" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel x:Name="WebPanel" Visibility="Collapsed">
            <CheckBox x:Name="CertBox" Content="Accept this site's certificate even if it is not trusted" Margin="0,12,0,0" />
            <TextBlock Text="For devices with a self-signed certificate (routers, Proxmox, printers). The check is skipped only for this connection's tab."
                       Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
        </StackPanel>

        <StackPanel x:Name="JumpPanel">
            <TextBlock Text="Jump host (optional)" Foreground="{StaticResource TextDim}" Margin="0,12,0,4" />
            <ComboBox x:Name="JumpBox" Padding="6,5" DisplayMemberPath="Label" />
            <TextBlock Text="Connects through another saved SSH connection, for hosts you can only reach via a bastion."
                       Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />

            <TextBlock Text="Port forwards (optional, one per line)" Foreground="{StaticResource TextDim}" Margin="0,12,0,4" />
            <TextBox x:Name="ForwardsBox" Padding="6,5" AcceptsReturn="True" MinLines="2" MaxLines="5"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
            <TextBlock Text="L:8080:db.internal:5432 opens local port 8080 to db.internal:5432 through the server. R:9000:localhost:3000 opens port 9000 on the server back to your localhost:3000. D:1080 is a SOCKS proxy. Listeners only accept connections from this computer."
                       Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />

            <CheckBox x:Name="ReconnectBox" Content="Reconnect automatically if the connection drops" Margin="0,12,0,0" />
            <CheckBox x:Name="LogBox" Content="Log session output to a file" Margin="0,8,0,0" />
            <TextBlock Text="Saves what the server prints, without colors, to the session logs folder. Passwords you type are not logged, but anything shown on screen is."
                       Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
        </StackPanel>

        <TextBlock Text="Folder" Foreground="{StaticResource TextDim}" Margin="0,12,0,4" />
        <ComboBox x:Name="FolderBox" Padding="6,5" DisplayMemberPath="Label" />

        <CheckBox x:Name="FavoriteBox" Content="Favorite" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save" IsDefault="True" Padding="18,5" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="18,5" />
        </StackPanel>
    </StackPanel>
</Window>
