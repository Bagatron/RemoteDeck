<Window x:Class="RemoteDeck.App.Dialogs.BackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteDeck" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Back}" Foreground="{StaticResource Text}">
    <StackPanel Margin="22">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Explanation" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />

        <!-- Export: choose whether the passwords go in. -->
        <CheckBox x:Name="PasswordsBox" Content="Include my saved passwords and API keys" Margin="0,16,0,0"
                  Checked="Passwords_Changed" Unchecked="Passwords_Changed" />

        <StackPanel x:Name="PassphrasePanel">
            <TextBlock x:Name="PassphraseLabel" Text="Passphrase" Margin="0,12,0,4" Foreground="{StaticResource TextDim}" />
            <PasswordBox x:Name="PassphraseBox" Padding="6,5" />
        </StackPanel>

        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
            <TextBlock Text="Repeat it" Margin="0,12,0,4" Foreground="{StaticResource TextDim}" />
            <PasswordBox x:Name="ConfirmBox" Padding="6,5" />
        </StackPanel>

        <!-- Restore: merge or overwrite. -->
        <CheckBox x:Name="OverwriteBox" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap"
                       Text="Replace items that already exist here (same connection, workspace or note). Leave this off to only add what is missing." />
        </CheckBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" IsDefault="True" Padding="18,5" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="18,5" />
        </StackPanel>
    </StackPanel>
</Window>
