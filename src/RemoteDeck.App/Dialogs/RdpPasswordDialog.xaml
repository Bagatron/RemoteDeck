<Window x:Class="RemoteDeck.App.Dialogs.RdpPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteDeck" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Back}" Foreground="{StaticResource Text}">
    <StackPanel Margin="22">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="The password goes to the remote desktop. Tick the box below to keep it in the encrypted vault for next time." Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextDim}" />
        <TextBlock Text="Password" Margin="0,14,0,4" Foreground="{StaticResource TextDim}" />
        <PasswordBox x:Name="PasswordBox" Padding="6,5" />
        <CheckBox x:Name="RememberBox" Content="Remember this password" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Connect" IsDefault="True" Padding="18,5" Margin="0,0,8,0" Click="Connect_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="18,5" />
        </StackPanel>
    </StackPanel>
</Window>
