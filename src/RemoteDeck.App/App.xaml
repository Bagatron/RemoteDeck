<Application x:Class="RemoteDeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="Back" Color="#2E3440" />
        <SolidColorBrush x:Key="Panel" Color="#3B4252" />
        <SolidColorBrush x:Key="PanelHover" Color="#434C5E" />
        <SolidColorBrush x:Key="Line" Color="#4C566A" />
        <SolidColorBrush x:Key="Text" Color="#D8DEE9" />
        <SolidColorBrush x:Key="TextDim" Color="#8F9BB3" />
        <SolidColorBrush x:Key="Accent" Color="#88C0D0" />
    </Application.Resources>
</Application>
