<Window x:Class="RemoteDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RemoteDeck" Width="1150" Height="720" MinWidth="560" MinHeight="360"
        Background="{StaticResource Back}" Foreground="{StaticResource Text}">
    <Window.Resources>
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Padding" Value="12,6,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Back}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="160" MaxWidth="600" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Saved connections -->
        <DockPanel Grid.Column="0" Background="{StaticResource Panel}">
            <StackPanel DockPanel.Dock="Top" Margin="8,8,8,6">
                <TextBox x:Name="SearchBox" Padding="6,4" VerticalContentAlignment="Center"
                         ToolTip="Search your connections" TextChanged="SearchBox_TextChanged" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="+ Connection" Padding="8,4" HorizontalAlignment="Stretch" Click="NewConnection_Click" />
                    <Button Grid.Column="2" Content="+ Folder" Padding="8,4" HorizontalAlignment="Stretch" Click="NewFolder_Click" />
                </Grid>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Button x:Name="ThemeButton" Content="Theme  &#x25BE;" Padding="10,4" HorizontalAlignment="Left" Click="ThemeButton_Click" />
            </Border>
            <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                      MouseDoubleClick="Tree_MouseDoubleClick" KeyDown="Tree_KeyDown"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">
                <TreeView.ContextMenu>
                    <ContextMenu Opened="TreeMenu_Opened">
                        <MenuItem x:Name="MenuOpen" Header="Open" Click="MenuOpen_Click" />
                        <MenuItem x:Name="MenuOpenNew" Header="Open in new tab" Click="MenuOpenNew_Click" />
                        <MenuItem x:Name="MenuEdit" Header="Edit..." Click="MenuEdit_Click" />
                        <MenuItem x:Name="MenuRename" Header="Rename folder..." Click="MenuRename_Click" />
                        <MenuItem x:Name="MenuDelete" Header="Delete" Click="MenuDelete_Click" />
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{StaticResource Line}" ShowsPreview="False" />

        <!-- Quick connect, tabs and terminals -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="8,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Quick connect" Padding="14,4" Margin="8,0,0,0" Click="Connect_Click" />
                    <TextBox x:Name="AddressBox" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="user@host or user@host:port, then press Enter"
                             KeyDown="AddressBox_KeyDown" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel>
                <Button DockPanel.Dock="Right" Content="+" ToolTip="New tab" Margin="4" Padding="10,0" FontSize="16" Click="NewTab_Click" />
                <ListBox x:Name="TabStrip" ItemsSource="{Binding Tabs}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TabItemStyle}"
                         SelectionChanged="TabStrip_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button Content="&#x2715;" Margin="10,0,0,0" Padding="5,0" FontSize="10" Background="Transparent"
                                        BorderThickness="0" Foreground="{StaticResource TextDim}" Cursor="Hand"
                                        ToolTip="Close tab" Click="CloseTabButton_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="8,5">
                <DockPanel>
                    <Button x:Name="LayoutButton" DockPanel.Dock="Left" Content="Layout  &#x25BE;" Padding="10,3" Click="LayoutButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Single pane" Tag="Single" Click="Preset_Click" />
                                <MenuItem Header="Two columns" Tag="TwoColumns" Click="Preset_Click" />
                                <MenuItem Header="Two rows" Tag="TwoRows" Click="Preset_Click" />
                                <MenuItem Header="2 x 2 grid" Tag="Grid2x2" Click="Preset_Click" />
                                <MenuItem Header="One big, two small" Tag="OneBigTwoSmall" Click="Preset_Click" />
                                <MenuItem Header="Three columns" Tag="ThreeColumns" Click="Preset_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <ToggleButton x:Name="BroadcastToggle" DockPanel.Dock="Left" Margin="8,0,0,0" Padding="10,3"
                                  Content="Broadcast: off" IsEnabled="False" Click="BroadcastToggle_Click"
                                  ToolTip="Mirror what you type in one grouped pane to every pane in the group" />
                    <Button DockPanel.Dock="Right" Content="Send" Margin="8,0,0,0" Padding="14,3" Click="SendCommand_Click" />
                    <TextBlock x:Name="BroadcastStatus" DockPanel.Dock="Left" Margin="12,0,12,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}" />
                    <TextBox x:Name="CommandBox" Padding="6,3" VerticalContentAlignment="Center" KeyDown="CommandBox_KeyDown"
                             ToolTip="Type a command and press Enter to run it on every pane in the broadcast group" />
                </DockPanel>
            </Border>

            <Grid>
                <wv2:WebView2 x:Name="Web" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
